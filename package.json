{
  "name": "mi-tienda-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "check:cash": "tsx server/selfcheck.ts",
    "db:push": "tsx server/scripts/dbPush.ts",
    "db:import": "tsx server/scripts/importSqlite.ts",
    "build:functions": "esbuild server/serverApp.ts --bundle --platform=node --target=node22 --format=cjs --outfile=functions/lib/server.js --external:express --external:pg --external:pg-native --log-level=warning",
    "deploy": "npm run build && npm run build:functions && firebase deploy --project plastimax-fr --only hosting,functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "autoprefixer": "^10.5.5",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.41.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "supabase": "^2.119.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
